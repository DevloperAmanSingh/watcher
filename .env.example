APP_ENV=dev

REDIS_HOST=127.0.0.1:6379
REDIS_PASS=''
REDIS_DB=0

MAXIMUM_CHILD_WORKERS=5
MAXIMUM_WORK_POOL_SIZE=25

HTTP_REQUEST_TIMEOUT=5

SUPERVISOR_POOL_FLUSH_TIMEOUT=5
SUPERVISOR_POOL_FLUSH_BATCHSIZE=100

DB_USER=watcher
DB_PASSWORD=watcher
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=watcher

GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?sslmode=disable"
GOOSE_MIGRATION_DIR=migrations

# Local mailpit (docker compose) — web UI at http://localhost:8025
MAIL_FROM_ADDRESS="alerts@watcher.local"
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
